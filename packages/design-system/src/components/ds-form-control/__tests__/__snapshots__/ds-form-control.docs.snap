# DsFormControl docs snippets

## Default

### Show code
{
  parameters: {
    docs: {
      source: {
        type: 'code'
      }
    }
  },
  render: function Render() {
    const [value, setValue] = useState('');
    return <DsFormControl label="Input" required={true} message="This is a message">
                <DsFormControl.Select placeholder="Select an option" value={value} onValueChange={setValue} clearable options={[{
        label: 'Option 1',
        value: 'option1',
        icon: 'download'
      }, {
        label: 'Option 2',
        value: 'option2',
        icon: 'save'
      }, {
        label: 'Option 3',
        value: 'option3',
        icon: 'description'
      }]} />
            </DsFormControl>;
  }
}

### MCP manifest
const Default = function Render() {
    const [value, setValue] = useState('');

    return (
        <DsFormControl label="Input" required={true} message="This is a message">
            <DsFormControl.Select
                placeholder="Select an option"
                value={value}
                onValueChange={setValue}
                clearable
                options={[
                    { label: 'Option 1', value: 'option1', icon: 'download' },
                    { label: 'Option 2', value: 'option2', icon: 'save' },
                    { label: 'Option 3', value: 'option3', icon: 'description' },
                ]}
            />
        </DsFormControl>
    );
};

