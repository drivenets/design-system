## Success

### Show code
{
  parameters: {
    docs: {
      source: {
        type: 'code'
      }
    }
  },
  render: function Render() {
    const [value] = useState('2024-12-25');
    return <DsFormControl status="success" label="Event Date" message="Valid date selected." messageIcon="check_circle">
                <DsFormControl.Description>
                    Optional helper text that describes the field in up to two lines.
                </DsFormControl.Description>
                <DsFormControl.DateInput value={value} />
            </DsFormControl>;
  }
}

### MCP manifest
const Success = function Render() {
    const [value] = useState('2024-12-25');

    return (
        <DsFormControl
            status="success"
            label="Event Date"
            message="Valid date selected."
            messageIcon="check_circle"
        >
            <DsFormControl.Description>
                Optional helper text that describes the field in up to two lines.
            </DsFormControl.Description>
            <DsFormControl.DateInput value={value} />
        </DsFormControl>
    );
};

