# DsSegmentGroup.Root docs snippets

## Default

### Show code
<DsSegmentGroup.Root defaultValue="react">
  <DsSegmentGroup.Item
    label="React"
    value="react"
  />
  <DsSegmentGroup.Item
    label="Vue"
    value="vue"
  />
  <DsSegmentGroup.Item
    label="Angular"
    value="angular"
  />
  <DsSegmentGroup.Item
    label="Svelte"
    value="svelte"
  />
</DsSegmentGroup.Root>

### MCP manifest
const Default = () => <DsSegmentGroup.Root defaultValue="react">
    <DsSegmentGroup.Item value="react" label="React" />
    <DsSegmentGroup.Item value="vue" label="Vue" />
    <DsSegmentGroup.Item value="angular" label="Angular" />
    <DsSegmentGroup.Item value="svelte" label="Svelte" />
</DsSegmentGroup.Root>;

