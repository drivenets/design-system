## Inline With Text

### Show code
{
  render: () => <DsStack alignItems="center" gap="var(--sm)">
            <DsLoader />
            <DsTypography variant="body-md-reg">Loading...</DsTypography>
        </DsStack>
}

### MCP manifest
const InlineWithText = () => (
    <DsStack alignItems="center" gap="var(--sm)">
        <DsLoader />
        <DsTypography variant="body-md-reg">Loading...</DsTypography>
    </DsStack>
);