## With Action

### Show code
<DsEmptyState
  action={<DsButtonV3 size="small">Add</DsButtonV3>}
  variant="noData"
/>

### MCP manifest
const WithAction = () => <DsEmptyState variant="noData" action={<DsButtonV3 size="small">Add</DsButtonV3>} />;

## Message

### Show code
<DsEmptyState
  message="No records match this search."
  variant="noMatches"
/>

### MCP manifest
const Message = () => <DsEmptyState variant="noMatches" message="No records match this search." />;

## Custom Illustration

### Show code
<DsEmptyState
  illustration={<DsIllustration variant="no-documents" />}
  variant="noData"
/>

### MCP manifest
const CustomIllustration = () => <DsEmptyState variant="noData" illustration={<DsIllustration variant="no-documents" />} />;