# DsTag docs snippets

## Default

### Show code
<DsTag
  label="Default Tag"
  onClick={() => {}}
/>

### MCP manifest
const Default = () => <DsTag label="Default Tag" />;

## Clickable

### Show code
<DsTag
  label="Clickable Tag"
  onClick={() => {}}
/>

### MCP manifest
const Clickable = () => <DsTag label="Clickable Tag" onClick={fn()} />;

## Controlled

### Show code
{
  parameters: {
    docs: {
      source: {
        type: 'code'
      }
    }
  },
  render: function Render() {
    const [deleted, setDeleted] = useState(false);
    const [selected, setSelected] = useState(true);
    if (deleted) {
      return <DsTypography variant="body-md-reg">Poof! Deleted!</DsTypography>;
    }
    return <DsTag selected={selected} label="Controlled" onDelete={() => setDeleted(true)} onClick={() => setSelected(!selected)} />;
  }
}

### MCP manifest
const Controlled = function Render() {
    const [deleted, setDeleted] = useState(false);
    const [selected, setSelected] = useState(true);

    if (deleted) {
        return <DsTypography variant="body-md-reg">Poof! Deleted!</DsTypography>;
    }

    return (
        <DsTag
            selected={selected}
            label="Controlled"
            onDelete={() => setDeleted(true)}
            onClick={() => setSelected(!selected)}
        />
    );
};

