## Operator Filter

### Show code
{
  parameters: {
    docs: {
      source: {
        type: 'code'
      }
    }
  },
  render: function Render() {
    const [operator, setOperator] = useState('ne');
    return <DsTag variant="operator-filter" label="Latency" value="120 ms" slots={{
      operator: <DsSelect size="small" value={operator} onValueChange={setOperator} options={[{
        label: '=',
        value: 'eq'
      }, {
        label: '≠',
        value: 'ne'
      }, {
        label: '>',
        value: 'gt'
      }, {
        label: '<',
        value: 'lt'
      }]} />
    }} />;
  }
}

### MCP manifest
const OperatorFilter = function Render() {
    const [operator, setOperator] = useState('ne');

    return (
        <DsTag
            variant="operator-filter"
            label="Latency"
            value="120 ms"
            slots={{
                operator: (
                    <DsSelect
                        size="small"
                        value={operator}
                        onValueChange={setOperator}
                        options={[
                            { label: '=', value: 'eq' },
                            { label: '≠', value: 'ne' },
                            { label: '>', value: 'gt' },
                            { label: '<', value: 'lt' },
                        ]}
                    />
                ),
            }}
        />
    );
};

