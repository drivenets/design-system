# DsDateRangePicker docs snippets

## Default

### Show code
<DsDateRangePicker
  className="_container_1g332_1"
  onChange={() => {}}
  value={[
    null,
    null
  ]}
/>

### MCP manifest
const Default = () => {
    const [value, setValue] = useState<DateRangeValue>([null, null]);

    return <DsDateRangePicker className={styles.container} value={value} onChange={setValue} />;
};

