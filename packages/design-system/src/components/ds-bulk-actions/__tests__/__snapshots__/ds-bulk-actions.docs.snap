## Menu Action

### Show code
<DsBulkActions
  onClearSelection={() => {}}
  selectedCount={3}
>
  <DsBulkActions.Item
    icon="alarm"
    label="Notify"
    onClick={() => {}}
  />
  <DsBulkActions.Item
    icon="share"
    label="Share"
    menu={[
      {
        icon: 'mail',
        label: 'Email',
        onSelect: () => {},
        value: 'email'
      },
      {
        icon: 'link',
        label: 'Copy link',
        onSelect: () => {},
        value: 'link'
      },
      {
        icon: 'delete_outline',
        label: 'Remove access',
        onSelect: () => {},
        value: 'delete',
        variant: 'error'
      }
    ]}
  />
  <DsBulkActions.Item
    icon="delete_outline"
    label="Delete"
    onClick={() => {}}
  />
</DsBulkActions>

### MCP manifest
const MenuAction = () => <DsBulkActions selectedCount={3} onClearSelection={fn()}>
    <DsBulkActions.Item icon="alarm" label="Notify" onClick={fn()} />
    <DsBulkActions.Item
        icon="share"
        label="Share"
        menu={[
            { value: 'email', label: 'Email', icon: 'mail', onSelect: fn() },
            { value: 'link', label: 'Copy link', icon: 'link', onSelect: fn() },
            {
                value: 'delete',
                label: 'Remove access',
                icon: 'delete_outline',
                variant: 'error',
                onSelect: fn(),
            },
        ]} />
    <DsBulkActions.Item icon="delete_outline" label="Delete" onClick={fn()} />
</DsBulkActions>;

## Nested Menu

### Show code
<DsBulkActions
  onClearSelection={() => {}}
  placement="floating"
  selectedCount={3}
>
  <DsBulkActions.Item
    icon="alarm"
    label="Notify"
    onClick={() => {}}
  />
  <DsBulkActions.Item
    icon="share"
    label="Share"
    menu={[
      {
        icon: 'mail',
        label: 'Email',
        onSelect: () => {},
        value: 'email'
      },
      {
        icon: 'link',
        label: 'More options',
        menu: [
          {
            label: 'Copy link',
            onSelect: () => {},
            value: 'copy-link'
          },
          {
            label: 'Social media',
            onSelect: () => {},
            value: 'social'
          }
        ],
        value: 'more'
      }
    ]}
  />
  <DsBulkActions.Item
    icon="delete_outline"
    label="Delete"
    onClick={() => {}}
  />
</DsBulkActions>

### MCP manifest
const NestedMenu = () => <DsBulkActions selectedCount={3} onClearSelection={fn()} placement="floating">
    <DsBulkActions.Item icon="alarm" label="Notify" onClick={fn()} />
    <DsBulkActions.Item
        icon="share"
        label="Share"
        menu={[
            { value: 'email', label: 'Email', icon: 'mail', onSelect: fn() },
            {
                value: 'more',
                label: 'More options',
                icon: 'link',
                menu: [
                    { value: 'copy-link', label: 'Copy link', onSelect: fn() },
                    { value: 'social', label: 'Social media', onSelect: fn() },
                ],
            },
        ]} />
    <DsBulkActions.Item icon="delete_outline" label="Delete" onClick={fn()} />
</DsBulkActions>;

