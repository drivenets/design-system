    selectedCount={3}
    onClearSelection={fn()}
    actions={[
        {
            icon: 'alarm',
            label: 'Notify',
            onClick: fn(),
        },
        {
            icon: 'folder_open',
            label: 'Folder',
            onClick: fn(),
        },
        {
            icon: 'delete_outline',
            label: 'Delete',
            onClick: fn(),
        },
    ]}
    placement="floating" />;

