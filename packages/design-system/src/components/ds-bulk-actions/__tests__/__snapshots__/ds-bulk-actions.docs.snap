  onClearSelection={() => {}}
  selectedCount={3}
>
  <DsBulkActions.Item
    icon="alarm"
    label="Notify"
    onClick={() => {}}
  />
  <DsBulkActions.Item
    icon="folder_open"
    label="Folder"
    onClick={() => {}}
  />
  <DsBulkActions.Item
    icon="delete_outline"
    label="Delete"
    onClick={() => {}}
  />
</DsBulkActions>

### MCP manifest
const Default = () => <DsBulkActions selectedCount={3} onClearSelection={fn()}>
    <DsBulkActions.Item icon="alarm" label="Notify" onClick={fn()} />
    <DsBulkActions.Item icon="folder_open" label="Folder" onClick={fn()} />
    <DsBulkActions.Item icon="delete_outline" label="Delete" onClick={fn()} />
</DsBulkActions>;

