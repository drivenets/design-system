## Controlled

### Show code
{
  parameters: {
    docs: {
      source: {
        type: 'code'
      }
    }
  },
  render: function Render() {
    const [value, setValue] = useState<DsSliderValue>(40);
    return <DsSlider label="Volume" value={value} onValueChange={setValue} formatValue={current => `${String(current)}%`} />;
  }
}

### MCP manifest
const Controlled = function Render() {
    const [value, setValue] = useState<DsSliderValue>(40);

    return (
        <DsSlider
            label="Volume"
            value={value}
            onValueChange={setValue}
            formatValue={(current) => `${String(current)}%`}
        />
    );
};