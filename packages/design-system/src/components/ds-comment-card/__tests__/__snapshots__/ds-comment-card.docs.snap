# DsCommentCard docs snippets

## Default

### Show code
<DsCommentCard
  comment={{
    author: {
      avatarSrc: 'https://i.pravatar.cc/40?img=1',
      id: 'user-1',
      name: 'Karen J.'
    },
    createdAt: new Date('2026-02-09T10:00:00.000Z'),
    id: 'comment-1',
    isResolved: false,
    messages: [
      {
        author: {
          avatarSrc: 'https://i.pravatar.cc/40?img=1',
          id: 'user-1',
          name: 'Karen J.'
        },
        content: 'We need to review the resource allocation for this project before the next sprint.',
        createdAt: new Date('2026-02-09T10:00:00.000Z'),
        id: 'msg-1',
        isInitialMessage: true
      },
      {
        author: {
          avatarSrc: 'https://i.pravatar.cc/40?img=2',
          id: 'user-2',
          name: 'John D.'
        },
        content: 'Thanks for the feedback!',
        createdAt: new Date('2026-02-09T12:00:00.000Z'),
        id: 'msg-2'
      }
    ],
    numericId: 63
  }}
  onClick={() => {}}
  onDelete={() => {}}
  onResolve={() => {}}
/>

