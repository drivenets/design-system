## Controlled Single Select

### Show code
{
  parameters: {
    docs: {
      source: {
        type: 'code'
      }
    }
  },
  render: () => {
    const [activeId, setActiveId] = useState<string | null>('errors');
    return <div className={styles.row}>
                {[{
        id: 'errors',
        label: 'Errors',
        value: '12'
      }, {
        id: 'warnings',
        label: 'Warnings',
        value: '48'
      }, {
        id: 'healthy',
        label: 'Healthy',
        value: '1,204'
      }].map(item => <DsToggleFilterData key={item.id} label={item.label} value={item.value} active={activeId === item.id} onActiveChange={next => setActiveId(next ? item.id : null)} />)}
            </div>;
  }
}

### MCP manifest
const ControlledSingleSelect = () => {
    const [activeId, setActiveId] = useState<string | null>('errors');

    return (
        <div className={styles.row}>
            {[
                { id: 'errors', label: 'Errors', value: '12' },
                { id: 'warnings', label: 'Warnings', value: '48' },
                { id: 'healthy', label: 'Healthy', value: '1,204' },
            ].map((item) => (
                <DsToggleFilterData
                    key={item.id}
                    label={item.label}
                    value={item.value}
                    active={activeId === item.id}
                    onActiveChange={(next) => setActiveId(next ? item.id : null)}
                />
            ))}
        </div>
    );
};

## Filters Group

### Show code
{
  parameters: {
    docs: {
      source: {
        type: 'code'
      }
    }
  },
  render: () => {
    const [activeIds, setActiveIds] = useState<string[]>(['region']);
    const toggle = (id: string, next: boolean) => setActiveIds(ids => next ? [...ids, id] : ids.filter(current => current !== id));
    return <div className={styles.row}>
                {[{
        id: 'region',
        label: 'Region',
        value: '3'
      }, {
        id: 'tenant',
        label: 'Tenant',
        value: '17'
      }, {
        id: 'interface',
        label: 'Interface',
        value: '92'
      }, {
        id: 'archived',
        label: 'Archived',
        value: '0',
        disabled: true
      }].map(item => <DsToggleFilterData key={item.id} label={item.label} value={item.value} active={activeIds.includes(item.id)} disabled={item.disabled} onActiveChange={next => toggle(item.id, next)} />)}
            </div>;
  }
}

### MCP manifest
const FiltersGroup = () => {
    const [activeIds, setActiveIds] = useState<string[]>(['region']);

    const toggle = (id: string, next: boolean) =>
        setActiveIds((ids) => (next ? [...ids, id] : ids.filter((current) => current !== id)));

    return (
        <div className={styles.row}>
            {[
                { id: 'region', label: 'Region', value: '3' },
                { id: 'tenant', label: 'Tenant', value: '17' },
                { id: 'interface', label: 'Interface', value: '92' },
                { id: 'archived', label: 'Archived', value: '0', disabled: true },
            ].map((item) => (
                <DsToggleFilterData
                    key={item.id}
                    label={item.label}
                    value={item.value}
                    active={activeIds.includes(item.id)}
                    disabled={item.disabled}
                    onActiveChange={(next) => toggle(item.id, next)}
                />
            ))}
        </div>
    );
};