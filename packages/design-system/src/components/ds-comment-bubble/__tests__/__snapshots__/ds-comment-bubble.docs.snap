<DsThreadItem
  author={{
    avatarSrc: 'https://i.pravatar.cc/150?img=1',
    id: 'user-1',
    name: 'Karen J.'
  }}
  canModify
  content="This is a sample message in the comment thread."
  createdAt={new Date("2026-02-09T09:00:00.000Z")}
  id="msg-1"
  isCommentAuthorMessage
  onDelete={() => {}}
  onEdit={() => {}}
  onMarkUnread={() => {}}
  onResolved={() => {}}
/>

### MCP manifest
const Default = () => <DsThreadItem
    id="msg-1"
    author={{ id: 'user-1', name: 'Karen J.', avatarSrc: 'https://i.pravatar.cc/150?img=1' }}
    content="This is a sample message in the comment thread."
    createdAt={new Date('2026-02-09T09:00:00Z')}
    isCommentAuthorMessage
    canModify
    onEdit={fn()}
    onDelete={fn()}
    onMarkUnread={fn()}
    onResolved={fn()} />;

