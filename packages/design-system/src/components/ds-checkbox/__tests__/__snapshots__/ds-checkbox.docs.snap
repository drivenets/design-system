# DsCheckbox docs snippets

## Default

### Show code
<DsCheckbox
  label="Enable notifications"
  labelInfo="Receive email updates"
/>

### MCP manifest
const Default = () => <DsCheckbox label="Enable notifications" labelInfo="Receive email updates" />;

## Controlled

### Show code
{
  parameters: {
    docs: {
      source: {
        type: 'code'
      }
    }
  },
  render: function Render() {
    const [checked, setChecked] = useState(false);
    return <DsCheckbox label="Enable notifications" labelInfo="Receive email updates" checked={checked} onCheckedChange={newState => {
      if (typeof newState === 'boolean') {
        setChecked(newState);
      }
    }} />;
  }
}

### MCP manifest
const Controlled = function Render() {
    const [checked, setChecked] = useState(false);

    return (
        <DsCheckbox
            label="Enable notifications"
            labelInfo="Receive email updates"
            checked={checked}
            onCheckedChange={(newState) => {
                if (typeof newState === 'boolean') {
                    setChecked(newState);
                }
            }}
        />
    );
};

