                            </DsStack>
                            <div className={styles.card}>
                                <DsTypography variant="body-md-reg">
                                    Extended shell content area with layout margins applied by WorkspaceLayout.Content inside
                                    Body.
                                </DsTypography>
                            </div>
                        </div>
                    </DsWorkspaceLayout.Content>
                </DsWorkspaceLayout.Body>
            </DsWorkspaceLayout>;
  }
}

