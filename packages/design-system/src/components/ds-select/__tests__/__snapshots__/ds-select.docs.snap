# DsSelect docs snippets

## Default

### Show code
{
  parameters: {
    docs: {
      source: {
        type: 'code'
      }
    }
  },
  render: function Render() {
    const [value, setValue] = useState('');
    return <DsSelect options={[{
      value: 'apple',
      label: 'Apple'
    }, {
      value: 'banana',
      label: 'Banana'
    }, {
      value: 'cherry',
      label: 'Cherry'
    }, {
      value: 'date',
      label: 'Date'
    }, {
      value: 'elderberry',
      label: 'Elderberry'
    }]} value={value} onValueChange={setValue} clearable onClear={() => setValue('')} />;
  }
}

### MCP manifest
const Default = function Render() {
    const [value, setValue] = useState('');

    return (
        <DsSelect
            options={[
                { value: 'apple', label: 'Apple' },
                { value: 'banana', label: 'Banana' },
                { value: 'cherry', label: 'Cherry' },
                { value: 'date', label: 'Date' },
                { value: 'elderberry', label: 'Elderberry' },
            ]}
            value={value}
            onValueChange={setValue}
            clearable
            onClear={() => setValue('')}
        />
    );
};

