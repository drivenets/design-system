## Interactive

### Show code
{
  parameters: {
    docs: {
      source: {
        type: 'code'
      }
    }
  },
  render: function Render() {
    const [selected, setSelected] = useState(false);
    return <DsCable from={{
      x: 40,
      y: 60
    }} to={{
      x: 320,
      y: 60
    }} type="iof" selected={selected} aria-label="IOF cable, Haifa North to Haifa South" onClick={() => setSelected(!selected)} />;
  }
}

### MCP manifest
const Interactive = function Render() {
    const [selected, setSelected] = useState(false);

    return (
        <DsCable
            from={{ x: 40, y: 60 }}
            to={{ x: 320, y: 60 }}
            type="iof"
            selected={selected}
            aria-label="IOF cable, Haifa North to Haifa South"
            onClick={() => setSelected(!selected)}
        />
    );
};

## Between Pins

### Show code
{
  parameters: {
    docs: {
      source: {
        type: 'code'
      }
    }
  },
  render: function Render() {
    const [selectedId, setSelectedId] = useState<string | null>('iof');
    return <div className={styles.map}>
                <DsCable from={{
        x: 80,
        y: 200
      }} to={{
        x: 400,
        y: 120
      }} type="iof" selected={selectedId === 'iof'} aria-label="IOF cable, Haifa North to Haifa South" onClick={() => setSelectedId('iof')} />
                <DsCable from={{
        x: 80,
        y: 200
      }} to={{
        x: 400,
        y: 120
      }} curvature={0.2} type="tie" line="dotted" selected={selectedId === 'tie'} aria-label="Tie cable, Haifa North to Haifa South, planned" onClick={() => setSelectedId('tie')} />
                <DsCable from={{
        x: 80,
        y: 200
      }} to={{
        x: 400,
        y: 120
      }} curvature={-0.2} type="loop" line="dashed" selected={selectedId === 'loop'} aria-label="Loop cable, Haifa North to Haifa South, designed" onClick={() => setSelectedId('loop')} />
                <DsMapPin className={styles.pin} style={{
        left: 80,
        top: 200
      }} label="T1" aria-label="Central office T1, Haifa North" />
                <DsMapPin className={styles.pin} style={{
        left: 400,
        top: 120
      }} label="T2" aria-label="Central office T2, Haifa South" />
            </div>;
  }
}

### MCP manifest
const BetweenPins = function Render() {
    const [selectedId, setSelectedId] = useState<string | null>('iof');

    return (
        <div className={styles.map}>
            <DsCable
                from={{ x: 80, y: 200 }}
                to={{ x: 400, y: 120 }}
                type="iof"
                selected={selectedId === 'iof'}
                aria-label="IOF cable, Haifa North to Haifa South"
                onClick={() => setSelectedId('iof')}
            />
            <DsCable
                from={{ x: 80, y: 200 }}
                to={{ x: 400, y: 120 }}
                curvature={0.2}
                type="tie"
                line="dotted"
                selected={selectedId === 'tie'}
                aria-label="Tie cable, Haifa North to Haifa South, planned"
                onClick={() => setSelectedId('tie')}
            />
            <DsCable
                from={{ x: 80, y: 200 }}
                to={{ x: 400, y: 120 }}
                curvature={-0.2}
                type="loop"
                line="dashed"
                selected={selectedId === 'loop'}
                aria-label="Loop cable, Haifa North to Haifa South, designed"
                onClick={() => setSelectedId('loop')}
            />
            <DsMapPin
                className={styles.pin}
                style={{ left: 80, top: 200 }}
                label="T1"
                aria-label="Central office T1, Haifa North"
            />
            <DsMapPin
                className={styles.pin}
                style={{ left: 400, top: 120 }}
                label="T2"
                aria-label="Central office T2, Haifa South"
            />
        </div>
    );
};