## Responsive Size

### Show code
{
  render: () => <DsStack direction="row" alignItems="center" gap="var(--sm)">
            <DsButtonV3 size={{
      lg: 'large',
      md: 'small'
    }}>lg: large / md: small</DsButtonV3>
            <DsButtonV3 size={{
      lg: 'medium',
      md: 'tiny'
    }}>lg: medium / md: tiny</DsButtonV3>
            <DsButtonV3 size="medium">static: medium</DsButtonV3>
        </DsStack>
}

### MCP manifest
const ResponsiveSize = () => (
    <DsStack direction="row" alignItems="center" gap="var(--sm)">
        <DsButtonV3 size={{ lg: 'large', md: 'small' }}>lg: large / md: small</DsButtonV3>
        <DsButtonV3 size={{ lg: 'medium', md: 'tiny' }}>lg: medium / md: tiny</DsButtonV3>
        <DsButtonV3 size="medium">static: medium</DsButtonV3>
    </DsStack>
);