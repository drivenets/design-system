## Disabled With Reason

### Show code
<DsButtonV3
  color="default"
  disabled
  disabledReason="You need edit access to delete this item"
  icon="delete"
  onClick={() => {}}
  size="medium"
  variant="primary"
>
  Delete
</DsButtonV3>

### MCP manifest
const DisabledWithReason = () => <DsButtonV3
    onClick={fn()}
    color="default"
    variant="primary"
    size="medium"
    icon="delete"
    disabled
    disabledReason="You need edit access to delete this item">Delete</DsButtonV3>;

## Icon Only Disabled With Reason

### Show code
<DsTooltip
  content="Delete"
  disabled
>
  <DsButtonV3
    aria-label="Delete"
    color="default"
    disabled
    disabledReason="Delete is unavailable: you need edit access"
    icon="delete"
    onClick={() => {}}
    size="medium"
    variant="tertiary"
  />
</DsTooltip>

### MCP manifest
const IconOnlyDisabledWithReason = () => <DsTooltip content="Delete" disabled>
    <DsButtonV3
        onClick={fn()}
        color="default"
        variant="tertiary"
        size="medium"
        icon="delete"
        aria-label="Delete"
        disabled
        disabledReason="Delete is unavailable: you need edit access" />
</DsTooltip>;

