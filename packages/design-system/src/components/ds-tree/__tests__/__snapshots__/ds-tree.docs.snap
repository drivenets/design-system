        name: 'IP address'
      }, {
        id: 'mac-address',
        name: 'MAC address'
      }, {
        id: 'vlan',
        name: 'VLAN'
      }]
    }, {
      id: 'location',
      name: 'Location',
      children: [{
        id: 'site',
        name: 'Site'
      }, {
        id: 'rack',
        name: 'Rack'
      }]
    }]));
    const renderNode = (node: DsTreeNode, indexPath: number[]): ReactNode => <DsTree.NodeProvider key={node.id} node={node} indexPath={indexPath}>
                {node.children ? <DsTree.Branch>
                        <DsTree.BranchControl>
                            <DsTree.BranchIndicator />
                            <DsTree.DragHandle />
                            <DsTree.NodeCheckbox />
                            <DsTree.BranchText>{node.name}</DsTree.BranchText>
                        </DsTree.BranchControl>

                        <DsTree.BranchContent>
                            <DsTree.BranchIndentGuide />
                            {node.children.map((child, index) => renderNode(child, [...indexPath, index]))}
                        </DsTree.BranchContent>
                    </DsTree.Branch> : <DsTree.Item>
                        <DsTree.ItemIndicator />
                        <DsTree.DragHandle />
                        <DsTree.NodeCheckbox />
                        <DsTree.ItemText>{node.name}</DsTree.ItemText>
                    </DsTree.Item>}
            </DsTree.NodeProvider>;
    return <DsTree.Root size={args.size} collection={collection} defaultExpandedValue={['general', 'connectivity', 'location']} defaultCheckedValue={['name', 'status', 'ip-address', 'site']}>
                <DsTree.Sortable canDrop={({
        position,
        fromParent,
        toParent
      }) => position !== 'inside' && fromParent?.id === toParent?.id} onCollectionChange={next => setCollection(next)}>
                    <DsTree.Tree>
                        {collection.rootNode.children?.map((node, index) => renderNode(node, [index]))}
                    </DsTree.Tree>
                </DsTree.Sortable>
            </DsTree.Root>;
  }
}

