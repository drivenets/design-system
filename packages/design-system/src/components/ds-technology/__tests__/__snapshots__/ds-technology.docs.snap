## Selectable

### Show code
{
  parameters: {
    docs: {
      source: {
        type: 'code'
      }
    }
  },
  render: function Render() {
    const [selectedId, setSelectedId] = useState<string | null>('och');
    const lines = [{
      id: 'och',
      type: 'och',
      label: 'OCH service, site A to site B',
      path: 'M24 136 C120 16 216 16 336 40'
    }, {
      id: 'odu',
      type: 'odu',
      label: 'ODU service, site A to site C',
      path: 'M24 136 C140 150 240 60 336 136'
    }, {
      id: 'oms',
      type: 'oms',
      label: 'OMS link, site D to site C',
      path: 'M24 24 C120 120 240 150 336 136'
    }] as const;
    const ordered = [...lines].sort((a, b) => Number(a.id === selectedId) - Number(b.id === selectedId));
    return <svg className={styles.canvas}>
                {ordered.map(line => <DsTechnology key={line.id} type={line.type} path={line.path} selected={line.id === selectedId} aria-label={line.label} onClick={() => setSelectedId(line.id === selectedId ? null : line.id)} />)}
            </svg>;
  }
}

### MCP manifest
const Selectable = function Render() {
    const [selectedId, setSelectedId] = useState<string | null>('och');

    const lines = [
        {
            id: 'och',
            type: 'och',
            label: 'OCH service, site A to site B',
            path: 'M24 136 C120 16 216 16 336 40',
        },
        {
            id: 'odu',
            type: 'odu',
            label: 'ODU service, site A to site C',
            path: 'M24 136 C140 150 240 60 336 136',
        },
        {
            id: 'oms',
            type: 'oms',
            label: 'OMS link, site D to site C',
            path: 'M24 24 C120 120 240 150 336 136',
        },
    ] as const;

    const ordered = [...lines].sort((a, b) => Number(a.id === selectedId) - Number(b.id === selectedId));

    return (
        <svg className={styles.canvas}>
            {ordered.map((line) => (
                <DsTechnology
                    key={line.id}
                    type={line.type}
                    path={line.path}
                    selected={line.id === selectedId}
                    aria-label={line.label}
                    onClick={() => setSelectedId(line.id === selectedId ? null : line.id)}
                />
            ))}
        </svg>
    );
};