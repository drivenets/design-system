const Locked = () => <DsFiltersBar.Root
    onConditionsChange={fn()}
    onQueryChange={fn()}
    onPinsChange={fn()}
    onExpandedChange={fn()}
    onViewChange={fn()}
    defaultExpanded
    fields={[
        {
            type: 'enum',
            id: 'status',
            label: 'Status',
            operators: [{ value: '=', label: 'equals' }],
            options: [{ value: 'active', label: 'Active' }],
        },
        {
            type: 'enum',
            id: 'trigger',
            label: 'Trigger',
            operators: [{ value: '=', label: 'equals' }],
            options: [{ value: 'scheduled', label: 'Scheduled' }],
        },
    ]}
    defaultQuery="status = \"active\" OR trigger = \"scheduled\"">
