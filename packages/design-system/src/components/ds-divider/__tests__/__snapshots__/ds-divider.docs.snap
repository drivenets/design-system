### MCP manifest
const Horizontal = () => <DsStack
    direction="column"
    gap="var(--sm)"
    alignItems="center"
    className={styles.horizontalDemo}>
    <DsTypography variant="body-md-reg">Above</DsTypography>
    <DsDivider orientation="horizontal" />
    <DsTypography variant="body-md-reg">Below</DsTypography>
</DsStack>;

