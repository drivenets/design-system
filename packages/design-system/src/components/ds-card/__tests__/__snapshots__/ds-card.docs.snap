## Selectable Controlled

### Show code
{
  parameters: {
    docs: {
      source: {
        type: 'code'
      }
    }
  },
  render: () => {
    const [selected, setSelected] = useState(false);
    return <DsCard.Root selectable selected={selected} onClick={() => setSelected(!selected)}>
                <DsCard.Header>Controlled Card</DsCard.Header>
                <DsCard.Body>{selected ? 'Selected! Click to deselect.' : 'Click to select.'}</DsCard.Body>
            </DsCard.Root>;
  }
}

### MCP manifest
const SelectableControlled = () => {
    const [selected, setSelected] = useState(false);

    return (
        <DsCard.Root selectable selected={selected} onClick={() => setSelected(!selected)}>
            <DsCard.Header>Controlled Card</DsCard.Header>
            <DsCard.Body>{selected ? 'Selected! Click to deselect.' : 'Click to select.'}</DsCard.Body>
        </DsCard.Root>
    );
};

