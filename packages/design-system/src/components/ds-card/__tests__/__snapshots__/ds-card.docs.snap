    Click to select this card
  </DsCard.Body>
</DsCard.Root>

### MCP manifest
const Selectable = () => <DsCard.Root selectable selected={false}>
    <DsCard.Header>Selectable Card</DsCard.Header>
    <DsCard.Body>Click to select this card</DsCard.Body>
</DsCard.Root>;

