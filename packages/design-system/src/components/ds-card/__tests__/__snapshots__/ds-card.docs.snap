        <DsTypography variant="body-sm-reg" color="secondary">5 or 10%
                            </DsTypography>
        <DsTypography variant="body-sm-reg">Threshold state</DsTypography>
        <DsTypography variant="body-sm-reg" color="secondary">Normal
                            </DsTypography>
    </DsCard.Body>
</DsCard.Root>;

