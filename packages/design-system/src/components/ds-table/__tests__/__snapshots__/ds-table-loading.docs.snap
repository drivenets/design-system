### MCP manifest
const CustomLoadingCell = () => <DsTable
    columns={columns.map((column, index) =>
        index === 0 ? Object.assign({}, column, { loadingCell: () => <DsSkeleton.Circle size="sm" /> }) : column,
    )}
    data={defaultData}
    stickyHeader
    bordered
    fullWidth
    loading />;