/>

### MCP manifest
const Reorderable = () => <DsTable
    columns={columns}
    data={defaultData.slice(0, 5)}
    stickyHeader
    bordered
    fullWidth
    expandable={false}
    onRowClick={fn()}
    reorderable
    onOrderChange={fn()} />;

