## Column Display With Saved State

### Show code
{
  args: {
    columnDisplay: true,
    primaryRowActions: [{
      icon: 'edit',
      label: 'Edit',
      onClick: fn()
    }, {
      icon: 'download',
      label: 'Download',
      onClick: fn()
    }]
  },
  parameters: {
    docs: {
      source: {
        type: 'code'
      }
    }
  },
  render: function Render(args) {
    const [columnVisibility, setColumnVisibility] = useState<VisibilityState>({
      lastName: false
    });
    const [stickyColumns, setStickyColumns] = useState<DsTableStickyColumns>({
      left: ['firstName', 'lastName']
    });
    return <DsTable {...args} columnVisibility={columnVisibility} onColumnVisibilityChange={setColumnVisibility} stickyColumns={stickyColumns} onStickyColumnsChange={setStickyColumns} />;
  }
}

### MCP manifest
const ColumnDisplayWithSavedState = () => {
    const [columnVisibility, setColumnVisibility] = useState<VisibilityState>({ lastName: false });
    const [stickyColumns, setStickyColumns] = useState<DsTableStickyColumns>({
        left: ['firstName', 'lastName'],
    });

    return (
        <DsTable
            columns={[
                { accessorKey: 'firstName', header: 'First Name', cell: (info) => info.getValue(), size: 180 },
                { accessorKey: 'lastName', header: 'Last Name', cell: (info) => info.getValue(), size: 180 },
                { accessorKey: 'age', header: 'Age', cell: (info) => info.getValue(), size: 140 },
                { accessorKey: 'visits', header: 'Visits', cell: (info) => info.getValue(), size: 160 },
                {
                    accessorKey: 'progress',
                    header: 'Profile Progress',
                    cell: (info) => `${String(info.getValue())}%`,
                    size: 200,
                },
                { accessorKey: 'status', header: 'Status', cell: (info) => info.getValue(), size: 160 },
            ]}
            data={defaultData}
            onRowClick={fn()}
            columnDisplay
            primaryRowActions={[
                { icon: 'edit', label: 'Edit', onClick: fn() },
                { icon: 'download', label: 'Download', onClick: fn() },
            ]}
            columnVisibility={columnVisibility}
            onColumnVisibilityChange={setColumnVisibility}
            stickyColumns={stickyColumns}
            onStickyColumnsChange={setStickyColumns} />
    );
};

## Column Display With Column Groups

### Show code
{
  args: {
    columns: [{
      id: 'identity',
      header: 'Identity',
      columns: [{
        accessorKey: 'firstName',
        header: 'First Name',
        cell: info => info.getValue<string>(),
        size: 160
      }, {
        accessorKey: 'lastName',
        header: 'Last Name',
        cell: info => info.getValue<string>(),
        size: 160
      }]
    }, {
      id: 'activity',
      header: 'Activity',
      columns: [{
        accessorKey: 'age',
        header: 'Age',
        cell: info => info.getValue<number>(),
        size: 140
      }, {
        accessorKey: 'visits',
        header: 'Visits',
        cell: info => info.getValue<number>(),
        size: 160
      }, {
        accessorKey: 'progress',
        header: 'Profile Progress',
        cell: info => `${String(info.getValue<number>())}%`,
        size: 200
      }]
    }, {
      accessorKey: 'status',
      header: 'Status',
      cell: info => info.getValue(),
      size: 160
    }],
    columnDisplay: true
  },
  parameters: {
    docs: {
      source: {
        type: 'code'
      }
    }
  },
  render: function Render(args) {
    const [columnVisibility, setColumnVisibility] = useState<VisibilityState>({
      visits: false
    });
    const [stickyColumns, setStickyColumns] = useState<DsTableStickyColumns>({
      left: ['identity']
    });
    return <DsTable {...args} columnVisibility={columnVisibility} onColumnVisibilityChange={setColumnVisibility} stickyColumns={stickyColumns} onStickyColumnsChange={setStickyColumns} />;
  }
}

### MCP manifest
const ColumnDisplayWithColumnGroups = () => {
    const [columnVisibility, setColumnVisibility] = useState<VisibilityState>({ visits: false });
    const [stickyColumns, setStickyColumns] = useState<DsTableStickyColumns>({ left: ['identity'] });

    return (
        <DsTable
            columns={[
                {
                    id: 'identity',
                    header: 'Identity',
                    columns: [
                        {
                            accessorKey: 'firstName',
                            header: 'First Name',
                            cell: (info) => info.getValue<string>(),
                            size: 160,
                        },
                        {
                            accessorKey: 'lastName',
                            header: 'Last Name',
                            cell: (info) => info.getValue<string>(),
                            size: 160,
                        },
                    ],
                },
                {
                    id: 'activity',
                    header: 'Activity',
                    columns: [
                        { accessorKey: 'age', header: 'Age', cell: (info) => info.getValue<number>(), size: 140 },
                        { accessorKey: 'visits', header: 'Visits', cell: (info) => info.getValue<number>(), size: 160 },
                        {
                            accessorKey: 'progress',
                            header: 'Profile Progress',
                            cell: (info) => `${String(info.getValue<number>())}%`,
                            size: 200,
                        },
                    ],
                },
                { accessorKey: 'status', header: 'Status', cell: (info) => info.getValue(), size: 160 },
            ]}
            data={defaultData}
            onRowClick={fn()}
            columnDisplay
            columnVisibility={columnVisibility}
            onColumnVisibilityChange={setColumnVisibility}
            stickyColumns={stickyColumns}
            onStickyColumnsChange={setStickyColumns} />
    );
};

