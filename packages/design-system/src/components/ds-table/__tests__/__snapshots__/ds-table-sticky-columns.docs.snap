const WithRowActions = () => <DsTable
    columns={[
        { accessorKey: 'firstName', header: 'First Name', cell: (info) => info.getValue(), size: 180 },
        { accessorKey: 'lastName', header: 'Last Name', cell: (info) => info.getValue(), size: 180 },
        { accessorKey: 'age', header: 'Age', cell: (info) => info.getValue(), size: 140 },
        { accessorKey: 'visits', header: 'Visits', cell: (info) => info.getValue(), size: 160 },
        {
            accessorKey: 'progress',
            header: 'Profile Progress',
            cell: (info) => `${String(info.getValue())}%`,
            size: 200,
        },
        { accessorKey: 'status', header: 'Status', cell: (info) => info.getValue(), size: 160 },
    ]}
    data={defaultData}
    onRowClick={fn()}
    stickyColumns={{ left: ['firstName'], right: ['status'] }}
    selectable
    primaryRowActions={[
        { icon: 'edit', label: 'Edit', onClick: fn() },
        { icon: 'download', label: 'Download', onClick: fn() },
    ]}
    secondaryRowActions={[{ icon: 'delete', label: 'Delete', onClick: fn() }]} />;

## Column Manager

### Show code
{
  args: {
    primaryRowActions: [{
      icon: 'edit',
      label: 'Edit',
      onClick: fn()
    }, {
      icon: 'download',
      label: 'Download',
      onClick: fn()
    }]
  },
  parameters: {
    docs: {
      source: {
        type: 'code'
      }
    }
  },
  render: function Render(args) {
    const managedColumns = [{
      id: 'firstName',
      label: 'First Name'
    }, {
      id: 'lastName',
      label: 'Last Name'
    }, {
      id: 'age',
      label: 'Age'
    }, {
      id: 'visits',
      label: 'Visits'
    }, {
      id: 'progress',
      label: 'Profile Progress'
    }, {
      id: 'status',
      label: 'Status'
    }];
    const searchId = useId();
    const [search, setSearch] = useState('');
    const [columnVisibility, setColumnVisibility] = useState<VisibilityState>({});
    const [stickyColumns, setStickyColumns] = useState<DsTableStickyColumns>({});
    const pinnedIds = stickyColumns.left ?? [];
    const isVisible = (id: string) => columnVisibility[id] !== false;
    const visibleCount = managedColumns.filter(({
      id
    }) => isVisible(id)).length;
    const allColumnsChecked = visibleCount === managedColumns.length ? true : visibleCount > 0 && 'indeterminate';
    const query = search.trim().toLowerCase();
    const matchingColumns = managedColumns.filter(({
      label
    }) => label.toLowerCase().includes(query));
    const setPinned = (id: string, pinned: boolean) => setStickyColumns({
      ...stickyColumns,
      left: pinned ? [...pinnedIds, id] : pinnedIds.filter(pinnedId => pinnedId !== id)
    });
    const setAllVisible = (visible: boolean) => setColumnVisibility(Object.fromEntries(managedColumns.map(({
      id
    }) => [id, visible])));
    return <DsTable {...args} columnVisibility={columnVisibility} onColumnVisibilityChange={setColumnVisibility} stickyColumns={stickyColumns} onStickyColumnsChange={setStickyColumns} controls={<DsStack direction="row" justifyContent="flex-end" width="100%">
                        <DsPopover.Root align="end" gutter={4}>
                            <DsPopover.Trigger>
                                <DsButtonV3 variant="tertiary" size="tiny" icon="view_column" aria-label="Columns" />
                            </DsPopover.Trigger>
                            <DsPopover.Panel width={240} aria-label="Columns" className={styles.columnManager}>
                                <label htmlFor={searchId} className={styles.visuallyHidden}>
                                    Search columns
                                </label>
                                <DsTextInput id={searchId} placeholder="Search" value={search} onValueChange={setSearch} slots={{
            startAdornment: <DsIcon icon="search" size="tiny" aria-hidden />
          }} />
                                <DsStack direction="column" className={styles.columnList}>
                                    {matchingColumns.map(({
              id,
              label
            }) => <DsCheckbox key={id} size="large" className={styles.columnRow} label={label} checked={isVisible(id)} onCheckedChange={checked => setColumnVisibility({
              ...columnVisibility,
              [id]: checked === true
            })} actions={<DsPinToggle className={styles.pinToggle} itemLabel={label} pinned={pinnedIds.includes(id)} onPinnedChange={pinned => setPinned(id, pinned)} />} />)}
                                    <DsCheckbox size="large" label="Row actions" checked disabled actions={<DsIcon icon="lock" size="tiny" color="secondary" aria-hidden />} />
                                </DsStack>
                                <DsDivider className={styles.divider} />
                                <DsCheckbox size="large" label="All columns" checked={allColumnsChecked} onCheckedChange={() => setAllVisible(allColumnsChecked !== true)} />
                            </DsPopover.Panel>
                        </DsPopover.Root>
                    </DsStack>} />;
  }
}

### MCP manifest
const ColumnManager = () => {
    const managedColumns = [
        { id: 'firstName', label: 'First Name' },
        { id: 'lastName', label: 'Last Name' },
        { id: 'age', label: 'Age' },
        { id: 'visits', label: 'Visits' },
        { id: 'progress', label: 'Profile Progress' },
        { id: 'status', label: 'Status' },
    ];
    const searchId = useId();
    const [search, setSearch] = useState('');
    const [columnVisibility, setColumnVisibility] = useState<VisibilityState>({});
    const [stickyColumns, setStickyColumns] = useState<DsTableStickyColumns>({});

    const pinnedIds = stickyColumns.left ?? [];
    const isVisible = (id: string) => columnVisibility[id] !== false;
    const visibleCount = managedColumns.filter(({ id }) => isVisible(id)).length;
    const allColumnsChecked =
        visibleCount === managedColumns.length ? true : visibleCount > 0 && 'indeterminate';
    const query = search.trim().toLowerCase();
    const matchingColumns = managedColumns.filter(({ label }) => label.toLowerCase().includes(query));

    const setPinned = (id: string, pinned: boolean) =>
        setStickyColumns({
            ...stickyColumns,
            left: pinned ? [...pinnedIds, id] : pinnedIds.filter((pinnedId) => pinnedId !== id),
        });

    const setAllVisible = (visible: boolean) =>
        setColumnVisibility(Object.fromEntries(managedColumns.map(({ id }) => [id, visible])));

    return (
        <DsTable
            columns={[
                { accessorKey: 'firstName', header: 'First Name', cell: (info) => info.getValue(), size: 180 },
                { accessorKey: 'lastName', header: 'Last Name', cell: (info) => info.getValue(), size: 180 },
                { accessorKey: 'age', header: 'Age', cell: (info) => info.getValue(), size: 140 },
                { accessorKey: 'visits', header: 'Visits', cell: (info) => info.getValue(), size: 160 },
                {
                    accessorKey: 'progress',
                    header: 'Profile Progress',
                    cell: (info) => `${String(info.getValue())}%`,
                    size: 200,
                },
                { accessorKey: 'status', header: 'Status', cell: (info) => info.getValue(), size: 160 },
            ]}
            data={defaultData}
            onRowClick={fn()}
            primaryRowActions={[
                { icon: 'edit', label: 'Edit', onClick: fn() },
                { icon: 'download', label: 'Download', onClick: fn() },
            ]}
            columnVisibility={columnVisibility}
            onColumnVisibilityChange={setColumnVisibility}
            stickyColumns={stickyColumns}
            onStickyColumnsChange={setStickyColumns}
            controls={
                <DsStack direction="row" justifyContent="flex-end" width="100%">
                    <DsPopover.Root align="end" gutter={4}>
                        <DsPopover.Trigger>
                            <DsButtonV3 variant="tertiary" size="tiny" icon="view_column" aria-label="Columns" />
                        </DsPopover.Trigger>
                        <DsPopover.Panel width={240} aria-label="Columns" className={styles.columnManager}>
                            <label htmlFor={searchId} className={styles.visuallyHidden}>
                                Search columns
                            </label>
                            <DsTextInput
                                id={searchId}
                                placeholder="Search"
                                value={search}
                                onValueChange={setSearch}
                                slots={{ startAdornment: <DsIcon icon="search" size="tiny" aria-hidden /> }}
                            />
                            <DsStack direction="column" className={styles.columnList}>
                                {matchingColumns.map(({ id, label }) => (
                                    <DsCheckbox
                                        key={id}
                                        size="large"
                                        className={styles.columnRow}
                                        label={label}
                                        checked={isVisible(id)}
                                        onCheckedChange={(checked) =>
                                            setColumnVisibility({ ...columnVisibility, [id]: checked === true })
                                        }
                                        actions={
                                            <DsPinToggle
                                                className={styles.pinToggle}
                                                itemLabel={label}
                                                pinned={pinnedIds.includes(id)}
                                                onPinnedChange={(pinned) => setPinned(id, pinned)}
                                            />
                                        }
                                    />
                                ))}
                                <DsCheckbox
                                    size="large"
                                    label="Row actions"
                                    checked
                                    disabled
                                    actions={<DsIcon icon="lock" size="tiny" color="secondary" aria-hidden />}
                                />
                            </DsStack>
                            <DsDivider className={styles.divider} />
                            <DsCheckbox
                                size="large"
                                label="All columns"
                                checked={allColumnsChecked}
                                onCheckedChange={() => setAllVisible(allColumnsChecked !== true)}
                            />
                        </DsPopover.Panel>
                    </DsPopover.Root>
                </DsStack>
            } />
    );
};

## Column Manager With Saved State

### Show code
{
  args: {
