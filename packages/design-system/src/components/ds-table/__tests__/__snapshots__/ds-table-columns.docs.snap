## Column Display Controlled

### Show code
{
  parameters: {
    docs: {
      source: {
        type: 'code'
      }
    }
  },
  render: function Render(args) {
    const [columnVisibility, setColumnVisibility] = useState<VisibilityState>({
      age: false,
      visits: false
    });
    return <DsStack direction="column" gap={16}>
                <DsStack direction="row">
                    <DsButtonV3 variant="secondary" size="small" onClick={() => setColumnVisibility({})}>
                        Show all columns
                    </DsButtonV3>
                </DsStack>

                <DsTable {...args} columnDisplay columnVisibility={columnVisibility} onColumnVisibilityChange={setColumnVisibility} />
            </DsStack>;
  }
}

### MCP manifest
const ColumnDisplayControlled = () => {
    const [columnVisibility, setColumnVisibility] = useState<VisibilityState>({ age: false, visits: false });

    return (
        <DsStack direction="column" gap={16}>
            <DsStack direction="row">
                <DsButtonV3 variant="secondary" size="small" onClick={() => setColumnVisibility({})}>Show all columns
                                        </DsButtonV3>
            </DsStack>

            <DsTable
                columns={columns}
                data={defaultData}
                stickyHeader
                bordered
                fullWidth
                expandable={false}
                onRowClick={fn()}
                columnDisplay
                columnVisibility={columnVisibility}
                onColumnVisibilityChange={setColumnVisibility} />
        </DsStack>
    );
};

## Column Reorder

### Show code
{
  parameters: {
    docs: {
      source: {
        type: 'code'
      }
    }
  },
  render: function Render(args) {
    const [columnOrder, setColumnOrder] = useState<string[]>([]);
    const [stickyColumns, setStickyColumns] = useState<DsTableStickyColumns>({
      left: ['identity']
    });
    const [reorderColumns] = useState<ColumnDef<Person>[]>(() => [{
      id: 'identity',
      header: 'Identity',
      columns: [{
        accessorKey: 'firstName',
        header: 'First Name',
        enableHiding: false
      }, {
        accessorKey: 'lastName',
        header: 'Last Name'
      }]
    }, {
      id: 'activity',
      header: 'Activity',
      columns: [{
        id: 'engagement',
        header: 'Engagement',
        columns: [{
          accessorKey: 'visits',
          header: 'Visits'
        }, {
          accessorKey: 'progress',
          header: 'Profile Progress'
        }]
      }, {
        accessorKey: 'status',
        header: 'Status'
      }]
    }, {
      accessorKey: 'age',
      header: 'Age'
    }]);
    return <DsStack direction="column" gap={16}>
                <DsStack direction="row">
                    <DsButtonV3 variant="secondary" size="small" onClick={() => setColumnOrder([])}>
                        Reset column order
                    </DsButtonV3>
                </DsStack>

                <DsTable {...args} columns={reorderColumns} columnDisplay reorderableColumns columnOrder={columnOrder} onColumnOrderChange={setColumnOrder} stickyColumns={stickyColumns} onStickyColumnsChange={setStickyColumns} />
            </DsStack>;
  }
}

### MCP manifest
const ColumnReorder = () => {
    const [columnOrder, setColumnOrder] = useState<string[]>([]);
    const [stickyColumns, setStickyColumns] = useState<DsTableStickyColumns>({ left: ['identity'] });

    const [reorderColumns] = useState<ColumnDef<Person>[]>(() => [
        {
            id: 'identity',
            header: 'Identity',
            columns: [
                { accessorKey: 'firstName', header: 'First Name', enableHiding: false },
                { accessorKey: 'lastName', header: 'Last Name' },
            ],
        },
        {
            id: 'activity',
            header: 'Activity',
            columns: [
                {
                    id: 'engagement',
                    header: 'Engagement',
                    columns: [
                        { accessorKey: 'visits', header: 'Visits' },
                        { accessorKey: 'progress', header: 'Profile Progress' },
                    ],
                },
                { accessorKey: 'status', header: 'Status' },
            ],
        },
        { accessorKey: 'age', header: 'Age' },
    ]);

    return (
        <DsStack direction="column" gap={16}>
            <DsStack direction="row">
                <DsButtonV3 variant="secondary" size="small" onClick={() => setColumnOrder([])}>Reset column order
                                        </DsButtonV3>
            </DsStack>

            <DsTable
                data={defaultData}
                stickyHeader
                bordered
                fullWidth
                expandable={false}
                onRowClick={fn()}
                columns={reorderColumns}
                columnDisplay
                reorderableColumns
                columnOrder={columnOrder}
                onColumnOrderChange={setColumnOrder}
                stickyColumns={stickyColumns}
                onStickyColumnsChange={setStickyColumns} />
        </DsStack>
    );
};

