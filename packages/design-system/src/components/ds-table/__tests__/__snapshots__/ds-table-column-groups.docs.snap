### MCP manifest
const Controlled = () => {
    const [collapsed, setCollapsed] = useState<string[]>(['activity']);

    return (
        <DsTable
            columns={buildColumns()}
            data={defaultData}
            stickyHeader
            bordered
            fullWidth
            selectable
            collapsedColumnGroups={collapsed}
            onCollapsedColumnGroupsChange={setCollapsed} />
    );
};

