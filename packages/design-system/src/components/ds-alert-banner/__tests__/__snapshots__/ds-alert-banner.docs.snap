## Controlled

### Show code
{
  parameters: {
    docs: {
      source: {
        type: 'code'
      }
    }
  },
  render: args => {
    const [open, setOpen] = useState(false);
    return <DsStack direction="column" alignItems="flex-start" gap="var(--standard)" width="400px">
                <DsButtonV3 variant="secondary" size="small" onClick={() => setOpen(true)}>
                    Show alert banner
                </DsButtonV3>
                <DsAlertBanner {...args} open={open} onOpenChange={setOpen}>
                    <DsAlertBanner.Title>Attention needed</DsAlertBanner.Title>
                    <DsAlertBanner.Body>Close this banner and use the button to bring it back.</DsAlertBanner.Body>
                </DsAlertBanner>
            </DsStack>;
  },
  args: {
    inline: true,
    variant: 'warning',
    icon: 'warning',
    closable: true
  }
}

### MCP manifest
const Controlled = () => {
    const [open, setOpen] = useState(false);

    return (
        <DsStack
            direction="column"
            alignItems="flex-start"
            gap="var(--standard)"
            width="400px">
            <DsButtonV3 variant="secondary" size="small" onClick={() => setOpen(true)}>Show alert banner
                                </DsButtonV3>
            <DsAlertBanner
                inline
                variant="warning"
                icon="warning"
                closable
                open={open}
                onOpenChange={setOpen}>
                <DsAlertBanner.Title>Attention needed</DsAlertBanner.Title>
                <DsAlertBanner.Body>Close this banner and use the button to bring it back.</DsAlertBanner.Body>
            </DsAlertBanner>
        </DsStack>
    );
};