# DsAlertBanner docs snippets

## Default

### Show code
<DsAlertBanner
  icon="info"
  inline
  onOpenChange={() => {}}
  open
  variant="info-blue"
>
  <DsAlertBanner.Title>
    Information
  </DsAlertBanner.Title>
  <DsAlertBanner.Body>
    This is a blue informational alert message.
  </DsAlertBanner.Body>
</DsAlertBanner>

### MCP manifest
const Default = () => <DsAlertBanner open onOpenChange={fn()} inline variant="info-blue" icon="info">
    <DsAlertBanner.Title>Information</DsAlertBanner.Title>
    <DsAlertBanner.Body>This is a blue informational alert message.</DsAlertBanner.Body>
</DsAlertBanner>;

