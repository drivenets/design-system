## Global

### Show code
{
  render: () => <DsAlertBanner inline={false} variant="info-blue" icon="info" closable open onOpenChange={() => {}}>
            <DsAlertBanner.Body>A new version is available. Refresh to update.</DsAlertBanner.Body>
        </DsAlertBanner>
}

### MCP manifest
const Global = () => (
    <DsAlertBanner inline={false} variant="info-blue" icon="info" closable open onOpenChange={() => {}}>
        <DsAlertBanner.Body>A new version is available. Refresh to update.</DsAlertBanner.Body>
    </DsAlertBanner>
);

## Closable

### Show code
<DsAlertBanner
  closable
  icon="info"
  inline
  onOpenChange={() => {}}
  open
  variant="info-neutral"
>
  <DsAlertBanner.Title>
    Dismissible
  </DsAlertBanner.Title>
  <DsAlertBanner.Body>
    You can close this banner with the button on the right.
  </DsAlertBanner.Body>
</DsAlertBanner>

### MCP manifest
const Closable = () => <DsAlertBanner
    open
    onOpenChange={fn()}
    inline
    variant="info-neutral"
    icon="info"
    closable>
    <DsAlertBanner.Title>Dismissible</DsAlertBanner.Title>
    <DsAlertBanner.Body>You can close this banner with the button on the right.</DsAlertBanner.Body>
</DsAlertBanner>;

## With Actions

### Show code
<DsAlertBanner
  icon="warning"
  inline
  onOpenChange={() => {}}
  open
  variant="warning"
>
  <DsAlertBanner.Title>
    Attention needed
  </DsAlertBanner.Title>
  <DsAlertBanner.Body>
    You successfully read this important alert message. Choose how you want to proceed.
  </DsAlertBanner.Body>
  <DsAlertBanner.Actions>
    <DsButtonV3
      color="error"
      size="small"
      variant="primary"
    >
      Proceed
    </DsButtonV3>
    <DsButtonV3
      size="small"
      variant="secondary"
    >
      Skip
    </DsButtonV3>
  </DsAlertBanner.Actions>
</DsAlertBanner>

### MCP manifest
const WithActions = () => <DsAlertBanner open onOpenChange={fn()} inline variant="warning" icon="warning">
    <DsAlertBanner.Title>Attention needed</DsAlertBanner.Title>
    <DsAlertBanner.Body>You successfully read this important alert message. Choose how you want to proceed.
                    </DsAlertBanner.Body>
    <DsAlertBanner.Actions>
        <DsButtonV3 color="error" variant="primary" size="small">Proceed
                            </DsButtonV3>
        <DsButtonV3 variant="secondary" size="small">Skip
                            </DsButtonV3>
    </DsAlertBanner.Actions>
</DsAlertBanner>;

