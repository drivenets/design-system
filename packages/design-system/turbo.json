{
	"$schema": "https://turborepo.com/schema.json",
	"extends": ["//"],
	"tasks": {
		"test": {
			"dependsOn": ["$TURBO_EXTENDS$", "install:playwright"]
		},
		"test:coverage": {
			"dependsOn": ["$TURBO_EXTENDS$", "install:playwright"]
		},
		"install:playwright": {
			"dependsOn": []
		},
		"build:storybook": {
			"outputs": ["storybook-static/**"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/vite-plugin/**"]
		},
		"test:visual": {
			"env": ["PW_WS_ENDPOINT"],
			"outputs": [".vitest/attachments/**"]
		},
		"test:storybook-docs": {
			"dependsOn": ["build:storybook", "install:playwright"]
		},
		"lint:styles": {
			"dependsOn": [],
			"inputs": ["src/**/*.scss", "stylelint.config.mjs"]
		},
		"figma:lint": {
			"dependsOn": [],
			"inputs": ["**/*.figma.ts", "figma.config.json"]
		}
	}
}
