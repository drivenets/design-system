{
	"projectId": "e497d050-1e1f-4b35-b157-506f0a32d37e",
	"shape": "storybook",
	"storybookConfigDir": "packages/design-system/.storybook",
	"pkg": "@drivenets/design-system",
	"globalName": "DrivenetsDesignSystem",
	"storybookStatic": ".design-sync/sb-reference",
	"cssEntry": "dist/index.min.css",
	"readmeHeader": ".design-sync/conventions.md",
	"libOverrides": {
		"story-imports.mjs": "repo uses kebab-case file/folder names (ds-avatar) with PascalCase exports (DsAvatar); upstream exportedComponentFor() only does exact string equality, so it never matched here and every story-local component import fell through to bundle-from-source, where .module.scss can't compile - fork adds a kebab->Pascal normalization fallback"
	},
	"storyImports": {
		"loaders": { ".ts?raw": "text" }
	},
	"overrides": {
		"DsPasswordInput": { "skip": ["components-formcontrol-password--with-help-icon"] },
		"DsPinToggle": { "skip": ["components-pintoggle--in-checkbox-row"] },
		"DsProgressLinear": { "skip": ["components-progresslinear--bar-only"] },
		"DsButton": { "cardMode": "column" },
		"DsCodeInput": { "cardMode": "single", "primaryStory": "Default" },
		"DsTable": { "cardMode": "single", "primaryStory": "Controlled" },
		"DsTagFilter": { "cardMode": "single", "primaryStory": "Default" },
		"DsTopBarNavigation": { "cardMode": "single", "primaryStory": "Default" },
		"DsAvatarGroup": { "cardMode": "column" },
		"DsBulkActions": { "cardMode": "column" },
		"DsCard": { "cardMode": "column" },
		"DsDivider": { "cardMode": "column" },
		"DsSpinner": { "cardMode": "single", "primaryStory": "Default" }
	},
